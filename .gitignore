# Godot local/editor state
godot/.godot/
godot/build/
.godot/

# Local saves, exports and generated binaries
*.tmp
*.log
*.pck
*.apk
*.aab
*.keystore

# Python cache used by local helper scripts
__pycache__/
*.pyc
.venv/
venv/

# Environment and secrets
.env
.env.*
*.env
*token.json*
*credentials.json*
credentials.json
*.pem
*.key

# Editors and OS files
.idea/
.vscode/
.DS_Store

# Dependency/build folders that should not reappear in this Godot branch
node_modules/
dist/
build/
coverage/

# Archives generated locally; existing tracked asset archives remain tracked
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
