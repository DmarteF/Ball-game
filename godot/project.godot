; Engine configuration file.
; Open this folder with Godot 4.x.

config_version=5

[application]

config/name="Neon Idle Escape Godot"
config/description="Godot 4 rebuild of the Ball-game / Neon Idle Escape experience."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile", "web")
config/icon="res://assets/images/app/icon.png"

[autoload]

GameData="*res://autoload/GameData.gd"
SaveSystem="*res://autoload/SaveSystem.gd"
AdsService="*res://autoload/AdsService.gd"
AudioManager="*res://autoload/AudioManager.gd"

[display]

window/size/viewport_width=420
window/size/viewport_height=760
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

touch_nudge={
"deadzone": 0.2,
"events": []
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1

