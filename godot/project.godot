; Engine configuration file.
; Best edited using the Godot editor, but kept small here for the clean rebuild.

config_version=5

[application]

config/name="Neon Idle Escape"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/icons/neon_idle_escape_app_icon_1024.png"
boot_splash/bg_color=Color(0.0196078, 0.0235294, 0.0705882, 1)
boot_splash/image="res://assets/icons/neon_idle_escape_app_icon_1024.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

SaveManager="*res://scripts/SaveManager.gd"
TimeManager="*res://scripts/TimeManager.gd"
MainPortData="*res://scripts/MainPortData.gd"
UpgradeDatabase="*res://scripts/UpgradeDatabase.gd"
GameState="*res://scripts/GameState.gd"
UpgradeManager="*res://scripts/UpgradeManager.gd"
AudioManager="*res://scripts/AudioManager.gd"
AdManager="*res://scripts/AdManager.gd"
LocalizationManager="*res://scripts/LocalizationManager.gd"
NavigationManager="*res://scripts/NavigationManager.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
